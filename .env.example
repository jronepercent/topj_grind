# ── Site ──
NEXT_PUBLIC_SITE_URL=https://topjgrind.com
# "true" = demo account switcher + magic links shown on screen. Anything else (or unset) = off.
# Never set to true on a public deployment.
NEXT_PUBLIC_DEMO_MODE=false

# ── Membership / payment (spec §9) ──
# Hosted payment page (e.g. your Kohort product link). Used for every plan unless the per-plan links below are set.
PAYMENT_URL=
# Optional: one Kohort link per plan (fall back to PAYMENT_URL). Card and PromptPay use the same link — the buyer picks on Kohort.
PAYMENT_URL_MONTHLY=
PAYMENT_URL_YEARLY=
PAYMENT_WEBHOOK_SECRET=change-me
# Shared secret for Kohort's outbound webhook (Kohort can't sign requests): https://<site>/api/webhooks/kohort?secret=<this>
# Use a long random string. Leave empty and the Kohort endpoint answers 503.
KOHORT_WEBHOOK_SECRET=
# Plan prices (990/month, 4,990/year) are fixed in src/lib/plans.ts — no env var needed.

# ── Cron (Vercel sends Authorization: Bearer CRON_SECRET) ──
CRON_SECRET=

# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Session pooler URI — used only by the npm run db:* scripts (migrations, seed, tests)
SUPABASE_DB_URL=
# Password for demo accounts created by npm run db:seed (generated automatically if empty)
DEMO_PASSWORD=

# ── Bunny Stream (Video) ──
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_CDN_HOST=          # e.g. vz-xxxxxxxx-xxx.b-cdn.net
BUNNY_STREAM_TOKEN_KEY=         # Pull zone → Security → Token Authentication key
BUNNY_WEBHOOK_SECRET=

# ── AI writer (server-only, never expose to the browser) ──
# ใช้กับปุ่ม "เขียนด้วย AI" ในหน้า Studio บทความ / Powers the Studio "เขียนด้วย AI" article panel.
ANTHROPIC_API_KEY=

# Podcast audio needs no extra keys: it is stored in the private Supabase Storage bucket "podcasts" (migration 0009).
